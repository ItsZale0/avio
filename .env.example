# Copia questo file in `.env` e compila solo cio' che ti serve.
# Le stesse impostazioni si possono cambiare anche dalla UI (ingranaggio in alto).

HOST=127.0.0.1
PORT=8787
DEFAULT_INTERVAL_MIN=60

# --- Notifiche Telegram ---
# 1) Crea un bot con @BotFather -> ottieni il token
# 2) Scrivi al bot, poi leggi il chat_id da https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Notifiche email (facoltative) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_TLS=1

# --- Fonti reali (facoltative) ---
# BlaBlaCar ha una API ufficiale gratuita: https://dev.blablacar.com
BLABLACAR_API_KEY=

# --- Intelligenza (Groq, gratuita) ---
# Chiave da https://console.groq.com/keys
GROQ_API_KEY=
AI_ENABLED=1
AI_MODEL_SMART=openai/gpt-oss-120b
AI_MODEL_FAST=openai/gpt-oss-20b

# --- Telefono / interfaccia remota (vedi docs/DEPLOY.md) ---
# URL pubblico del tunnel: usato nei link delle notifiche
CARPOOL_PUBLIC_URL=
# Origini web ammesse per l'API (es. l'interfaccia su Cloudflare Pages)
CARPOOL_CORS_ORIGINS=
# ngrok (facoltativo): URL pubblico STABILE, funziona sulla porta 443.
# Serve quando la rete blocca la 7844 di Cloudflare.
# 1) account gratuito su https://dashboard.ngrok.com
# 2) authtoken: https://dashboard.ngrok.com/get-started/your-authtoken
# 3) scarica ngrok.exe e mettilo nella cartella del progetto
NGROK_AUTHTOKEN=

# --- Comportamento agente ---
QUIET_FROM=23:00
QUIET_TO=07:00
